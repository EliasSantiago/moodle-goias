{{!
    @template core/login_layout

    Login-flow pages (login, MFA, etc.) in the AuthLayout of the Design System
    Goiás: government bar, "back to home" link and colour scheme selector, and
    the login card centred on the canvas, with the brand panel on the left.

    Context variables required for this template:
    * output - The core renderer output object (provides main_content).

    Example context (json):
    {
        "output": {
            "main_content": "<h1>Login form goes here</h1>",
            "goias_auth": {
                "showgovbar": true,
                "organization": "Governo de Goiás",
                "govbarurl": "https://www.go.gov.br",
                "govbarhost": "go.gov.br",
                "homeurl": "https://example.com",
                "colorscheme": ""
            }
        }
    }
}}
<div id="page-content" class="goias-auth">
    {{#output.goias_auth}}
        {{#showgovbar}}
            <div class="goias-govbar">
                <div class="goias-govbar-inner">
                    <span class="text-truncate">{{#str}}govbar, theme_goias{{/str}} <strong>{{organization}}</strong></span>
                    {{#govbarurl}}
                        <a href="{{govbarurl}}" class="flex-shrink-0" rel="noopener">{{govbarhost}}</a>
                    {{/govbarurl}}
                </div>
            </div>
        {{/showgovbar}}
        <div class="goias-auth-topbar">
            <a href="{{homeurl}}" class="goias-auth-back">
                <svg class="goias-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
                </svg>
                {{#str}}backtohome, theme_goias{{/str}}
            </a>
            {{{colorscheme}}}
        </div>
    {{/output.goias_auth}}
    <div class="goias-auth-main">
        <div class="goias-auth-card">
            <aside class="login-layout-left goias-auth-aside d-none d-md-flex">
                {{> core/login_panel }}
            </aside>
            <div id="region-main" class="login-layout-right goias-auth-body">
                <div id="region-main-box" class="login-layout-right-content">
                    <div class="login-container">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
