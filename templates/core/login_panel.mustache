{{!
    @template core/login_panel

    Left panel of the login card (theme_goias version), as the LoginPanel of the
    Design System Goiás: brand gradient with decorative shapes, an eyebrow
    (organisation), a title and a text configured in the theme settings.

    When leftinstructions is provided (custom auth instructions configured in
    the site), it replaces the welcome copy, as in Boost.

    Example context (json):
    {
        "leftinstructions": "",
        "output": {
            "goias_login_panel": {
                "eyebrow": "Governo de Goiás",
                "title": "Virtual learning environment",
                "text": "<p>Sign in to access your courses.</p>",
                "logourl": ""
            }
        }
    }
}}
<span class="goias-auth-blur" aria-hidden="true"></span>
<span class="goias-auth-ring" aria-hidden="true"></span>
<div class="login-layout-left-content goias-login-panel">
    {{#output.goias_login_panel}}
        {{#logourl}}
            <img src="{{logourl}}" alt="" class="goias-login-logo">
        {{/logourl}}
        {{^leftinstructions}}
            {{#eyebrow}}
                <p class="goias-login-eyebrow">{{eyebrow}}</p>
            {{/eyebrow}}
            <p class="goias-login-title">{{title}}</p>
            {{#text}}
                <div class="goias-login-text">{{{text}}}</div>
            {{/text}}
        {{/leftinstructions}}
    {{/output.goias_login_panel}}
    {{#leftinstructions}}
        <div class="goias-login-text">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
