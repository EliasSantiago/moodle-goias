{{!
    @template theme_goias/colorscheme_toggle

    Colour scheme selector (ThemeSelector of the Design System Goiás) as a menu:
    light, dark, high contrast and follow the device. The button shows the icon
    of the current choice, picked in CSS from html[data-goias-scheme].

    Example context (json):
    {
        "uniqid": "goias-colorscheme-1",
        "schemes": [
            {"value": "light", "label": "Light", "paths": ["M12 3v2.25"]},
            {"value": "dark", "label": "Dark", "paths": ["M21.752 15.002"]}
        ]
    }
}}
<div class="dropdown goias-colorscheme d-flex align-items-center">
    <button type="button"
            id="{{uniqid}}-button"
            class="btn goias-colorscheme-toggle"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
            title="{{#str}}colorscheme, theme_goias{{/str}}">
        <span class="visually-hidden">{{#str}}colorscheme, theme_goias{{/str}}</span>
        {{#schemes}}
            <svg class="goias-icon goias-scheme-current goias-scheme-current-{{value}}" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true" focusable="false">
                {{#paths}}<path d="{{.}}"/>{{/paths}}
            </svg>
        {{/schemes}}
    </button>
    <div class="dropdown-menu dropdown-menu-end" role="menu" aria-labelledby="{{uniqid}}-button">
        {{#schemes}}
            <button type="button" class="dropdown-item" role="menuitemradio" aria-checked="false"
                    data-goias-scheme-option="{{value}}">
                <svg class="goias-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    {{#paths}}<path d="{{.}}"/>{{/paths}}
                </svg>
                {{label}}
            </button>
        {{/schemes}}
    </div>
</div>
